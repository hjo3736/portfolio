{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh repo:*)",
      "Bash(wrangler:*)",
      "Bash(npx wrangler:*)",
      "Bash(npm publish:*)",
      "Edit(.openai/hosting.json)",
      "Edit(dist/**)",
      "Edit(drizzle/**)",
      "Edit(.claude/settings.json)",
      "Edit(CLAUDE.md)"
    ],
    "allow": [
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:comments:*)",
      "Bash(npm run build:*)",
      "Bash(npm run preview:*)",
      "Bash(npm run db:generate:*)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(mkdir:*)",
      "Edit(claude-team/**)"
    ]
  }
}
