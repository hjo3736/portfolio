{
  "name": "vertex-portfolio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run preview",
    "build": "node scripts/build-client.js && node scripts/build-server.js",
    "preview": "node scripts/preview.js",
    "test": "node --test tests/*.test.js",
    "db:generate": "drizzle-kit generate",
    "test:comments": "node --test tests/comments.test.js",
    "posts:import": "node scripts/posts-import.js",
    "posts:export": "node scripts/posts-export.js",
    "posts:delete": "node scripts/posts-delete.js",
    "posts:editor": "node scripts/posts-editor.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@rolldown/binding-wasm32-wasi": "^1.2.9",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "miniflare": "^4.20260730.0",
    "vite": "^8.3.0"
  }
}
